# ===== Existing V4 AI summary (optional) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ===== V5 persistent alert database =====
# Use the Supabase project URL + SERVICE ROLE key (server-side only).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===== V5 Gmail sender =====
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Stock News Intelligence

# Optional fallback recipients, comma-separated.
# Users can also subscribe in the Alerts & Urgency tab.
ALERT_RECIPIENTS=your.receiver@gmail.com
EMAIL_URGENCY_THRESHOLD=70

# Background scanner universe (comma-separated)
WATCH_TICKERS=FPT,TCB,VIC,VHM,PVS,SSI,VCB,BID,CTG,MBB,VPB,HPG,MWG,VNM,GAS
NEWS_LOOKBACK_DAYS=2
NEWS_MAX_PER_TICKER=20
EMAIL_LOOKBACK_HOURS=24
EMAIL_MAX_ARTICLES=20
